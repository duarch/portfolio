# Reference only. Real values stay in ignored .env / .dev.vars files or Worker secrets.
# D1 is a Worker binding DB, not a public connection string.
# Replace database_id in wrangler.jsonc after manually creating support-db.
CLOUDFLARE_ACCOUNT_ID=<account-id-for-wrangler>
D1_DATABASE_ID=<database-id-copy-to-wrangler-config>
SUPPORT_ORIGIN=https://duar.ch
SUPPORT_MOCK_SERVICES=false
R2_ACCOUNT_ID=<r2-account-id>
R2_ACCESS_KEY_ID=<bucket-scoped-access-key>
R2_SECRET_ACCESS_KEY=<bucket-scoped-secret>
R2_BUCKET=duarch-support-attachments
RESEND_API_KEY=<send-only-api-key>
EMAIL_FROM_INTERNAL=form@notify.duar.ch
EMAIL_FROM_USER=support@notify.duar.ch
SUPPORT_INBOX=support@duar.ch
TURNSTILE_SITE_KEY=<public-site-key>
TURNSTILE_SECRET_KEY=<private-secret-key>
ADMIN_API_TOKEN=<long-random-token>
UPLOAD_SIGNING_SECRET=<independent-long-random-secret>
# Required before production submissions; no legal policy is invented by this app.
PRIVACY_POLICY_URL=https://duar.ch/support/privacy/
# Optional development-only Turnstile TEST keys (do not enable real calls by default):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
